# Public URL of this server (OAuth metadata and callbacks are built from it). compose maps it to port 8000.
APP_URL=http://localhost:8000
# Set by compose for the api container; only needed when running outside compose.
# DATABASE_URL=postgresql://quiz:secret@localhost:5433/quiz

# GitHub OAuth app (https://github.com/settings/developers). Callback URL: <APP_URL>/auth/callback
# Production only. Leave empty locally: on localhost, sign-in is then mocked and every request is the user "dev".
# Empty on any other APP_URL and the server refuses to start.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Generate each with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Signs the tokens this server issues to MCP/REST clients. Changing it logs everyone out.
JWT_SIGNING_KEY=
# Encrypts OAuth clients and upstream GitHub tokens at rest (kv_store table).
STORAGE_ENCRYPTION_KEY=

# Shown on the sign-up page as the Claude Code plugin marketplace: owner/repo or a local path. Empty hides it.
PLUGIN_MARKETPLACE=

# Comma-separated GitHub logins allowed in.
ALLOWED_USERS=
