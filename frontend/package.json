{
  "name": "quiz-api-frontend",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "build": "tailwindcss -i ./src/input.css -o ../app/static/app.css --minify && pnpm build:editor",
    "build:editor": "esbuild src/editor.js --bundle --minify --format=esm --target=es2020 --outfile=../app/static/editor.js",
    "watch": "pnpm run --parallel \"/^watch:/\"",
    "watch:css": "tailwindcss -i ./src/input.css -o ../app/static/app.css --watch",
    "watch:editor": "esbuild src/editor.js --bundle --format=esm --target=es2020 --outfile=../app/static/editor.js --watch=forever"
  },
  "devDependencies": {
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@lezer/highlight": "1.2.5",
    "@tailwindcss/cli": "4.3.3",
    "codemirror": "6.0.2",
    "esbuild": "0.28.2",
    "tailwindcss": "4.3.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild"
    ]
  }
}
